# ==============================================================================
# ArthaFlow Environment Variables Configuration
# Salin file ini menjadi `.env.local` untuk development lokal atau pasang di Vercel:
# cp .env.example .env.local
# ==============================================================================

# Supabase Project URL (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public API Key (Dashboard -> Project Settings -> API -> Anon / Public Key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# (Opsional) Supabase Publishable Key jika menggunakan format key baru
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ==============================================================================
# Telegram Bot Transaction Gateway Integration
# ==============================================================================
# Bot Token dari @BotFather di Telegram (e.g. 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=

# Username Bot Telegram tanpa tanda @ (digunakan untuk link deep-pairing)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=arthaflow_bot

# Secret Token untuk validasi otentisitas webhook Telegram (header X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=
