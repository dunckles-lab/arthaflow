# ==============================================================================
# ArthaFlow Environment Variables Configuration
# Salin file ini menjadi `.env.local` untuk development lokal atau pasang di Vercel:
# cp .env.example .env.local
# ==============================================================================

# Supabase Project URL (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public API Key (Dashboard -> Project Settings -> API -> Anon / Public Key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# (Opsional) Supabase Publishable Key jika menggunakan format key baru
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
